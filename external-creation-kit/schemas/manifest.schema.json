{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni-external:manifest:v1",
  "title": "Omni external manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "omni-external-manifest.v1"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
    },
    "deliveryId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
    },
    "baseDeliveryId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "full",
            "selected"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "description"
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bible": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+\\.(json|md)$"
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]+\\.(json|md)$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "interactive": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_./-]+\\.(json|md)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+\\.(json|md)$"
        }
      },
      "required": [
        "bible",
        "scripts",
        "interactive",
        "notes"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characterIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unitIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "sceneIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "characterIds",
        "unitIds",
        "sceneIds",
        "nodeIds"
      ]
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "addedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "modifiedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "deletedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,119}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "summary",
        "addedIds",
        "modifiedIds",
        "deletedIds"
      ]
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "format",
    "projectId",
    "deliveryId",
    "baseDeliveryId",
    "status",
    "scope",
    "files",
    "inventory",
    "changes",
    "openQuestions"
  ]
}
